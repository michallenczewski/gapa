{
  "name": "podglad",
  "productName": "Gapa",
  "version": "0.6.5",
  "description": "Prosta przeglądarka obrazów — zamiennik Adobe Bridge",
  "author": "Michał Lenczewski",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "pl.lenczewski.podglad",
    "productName": "Gapa",
    "artifactName": "Gapa-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "node_modules/pdfjs-dist/build/pdf.min.mjs",
      "node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
      "node_modules/pdfjs-dist/package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null,
      "extendInfo": {
        "CFBundleDisplayName": "Gapa"
      }
    },
    "dmg": {
      "title": "Gapa ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-win.png",
      "executableName": "Gapa"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Gapa"
    },
    "afterSign": "build/adhoc.js"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  }
}
